NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
DATABASE_URL=postgresql://memora:change_me_locally@localhost:5432/memora
DATABASE_APP_URL=postgresql://memora_app:change_me_app_locally@localhost:5432/memora
# Optional dedicated service role for cross-workspace cleanup (falls back to DATABASE_URL)
# DATABASE_SYSTEM_URL=postgresql://memora:change_me_locally@localhost:5432/memora
POSTGRES_DB=memora
POSTGRES_USER=memora
POSTGRES_PASSWORD=change_me_locally
REDIS_URL=redis://localhost:6379
# MEM-024 durable source ingestion orchestration
INGESTION_OUTBOX_POLL_MS=2000
INGESTION_OUTBOX_LEASE_SECONDS=60
INGESTION_WORKER_LEASE_SECONDS=120
INGESTION_WORKER_HEARTBEAT_MS=30000
INGESTION_RECOVERY_POLL_MS=15000
INGESTION_WORKER_CONCURRENCY=5
INGESTION_MAX_ATTEMPTS=5
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
BETTER_AUTH_URL=http://localhost:4000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=MEMORA <noreply@example.com>

# Private S3-compatible object storage (bucket must be private and hosted in the EU)
OBJECT_STORAGE_PROVIDER=s3-compatible
OBJECT_STORAGE_ENDPOINT=https://s3.eu-west-1.example-provider.com
OBJECT_STORAGE_REGION=eu-west-1
OBJECT_STORAGE_BUCKET=memora-private
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Server-side pending upload lifetime (independent from 5-minute presigned URLs)
OBJECT_UPLOAD_TTL_SECONDS=1800
